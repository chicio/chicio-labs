{
  "name": "labs-hub",
  "version": "0.0.0",
  "description": "The site that presents every Lab Project and renders their docs, generated at build time from files already in the repository.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
