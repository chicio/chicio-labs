---
import { CallToActionExternalWithTracking, Chip, SectionHeading } from "matrix-design-system";
import DocumentBody from "../../../components/DocumentBody.astro";
import Layout from "../../../layouts/Layout.astro";
import { kindLabel } from "../../../lib/catalog";
import { loadHubContent, type LabProject } from "../../../lib/content";

export async function getStaticPaths() {
    const { projects } = await loadHubContent();

    return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
    project: LabProject;
}

const { project } = Astro.props;
const newTab = { target: "_blank", rel: "noopener noreferrer" };
---

<Layout title={project.name} description={project.description}>
    {
        project.readme ? (
            <DocumentBody html={project.readme.html} />
        ) : (
            <div class="docs">
                <h1>{project.name}</h1>
                <p>{project.description}</p>
            </div>
        )
    }

    <section class="glow-container mt-12 flex flex-col gap-5 p-4 md:p-8">
        <SectionHeading title={`More about ${project.name}`} />
        <div class="flex flex-wrap items-center gap-2">
            <Chip>{kindLabel[project.kind]}</Chip>
            {project.version && project.kind !== "workbench" && <Chip>{`version ${project.version}`}</Chip>}
            {project.packageName && <Chip>{project.packageName}</Chip>}
        </div>
        <div class="flex flex-wrap items-center gap-4">
            {
                project.changelogUrl && (
                    <CallToActionExternalWithTracking href={project.changelogUrl}>Changelog</CallToActionExternalWithTracking>
                )
            }
            {
                project.showcase && (
                    <CallToActionExternalWithTracking href={project.showcase.url} {...newTab}>
                        {project.showcase.label}
                    </CallToActionExternalWithTracking>
                )
            }
            <CallToActionExternalWithTracking href={project.sourceUrl} {...newTab}>
                Source
            </CallToActionExternalWithTracking>
        </div>
    </section>
</Layout>
