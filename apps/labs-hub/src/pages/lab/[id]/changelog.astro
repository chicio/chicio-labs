---
import { TerminalButton } from "matrix-design-system";
import DocumentBody from "../../../components/DocumentBody.astro";
import Layout from "../../../layouts/Layout.astro";
import { loadHubContent, type HubDocument, type LabProject } from "../../../lib/content";

export async function getStaticPaths() {
    const { projects } = await loadHubContent();

    return projects.flatMap((project) =>
        project.changelog ? [{ params: { id: project.id }, props: { project, changelog: project.changelog } }] : [],
    );
}

interface Props {
    project: LabProject;
    changelog: HubDocument;
}

const { project, changelog } = Astro.props;
---

<Layout title={`${project.name} changelog`} description={`The changelog of ${project.name}.`}>
    <div class="mb-6">
        <TerminalButton label={`Back to ${project.name}`} to={project.url} />
    </div>
    <DocumentBody html={changelog.html} />
</Layout>
