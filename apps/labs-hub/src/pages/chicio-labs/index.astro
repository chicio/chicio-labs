---
import DocumentBody from "../../components/DocumentBody.astro";
import EntryList from "../../components/EntryList.astro";
import Layout from "../../layouts/Layout.astro";
import { loadHubContent } from "../../lib/content";

const { system } = await loadHubContent();
---

<Layout
    title="Chicio Labs"
    description="What Chicio Labs is, its glossary map and the decisions that shape the whole repository."
>
    <DocumentBody html={system.readme.html} />
    <section id="glossary-map" class="scroll-target mt-10">
        <DocumentBody html={system.glossaryMap.html} />
    </section>
    <EntryList
        heading="Decisions"
        id="decisions"
        entries={system.adrs.map((adr) => ({
            title: adr.title,
            description: `ADR ${adr.number}`,
            href: adr.url,
        }))}
    />
</Layout>
