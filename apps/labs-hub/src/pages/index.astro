---
import { standaloneProjects } from "labs-catalog";
import { SectionHeading } from "matrix-design-system";
import { optimizedCardImage } from "../components/card-image";
import HubCard from "../components/HubCard.astro";
import Layout from "../layouts/Layout.astro";
import { homeSections } from "../lib/catalog";
import { loadHubContent } from "../lib/content";

const { projects } = await loadHubContent();

const sections = await Promise.all(
    homeSections(projects, standaloneProjects).map(async (section) => ({
        ...section,
        cards: await Promise.all(
            section.cards.map(async (card) => ({
                card,
                image: card.image ? await optimizedCardImage(card.image) : undefined,
            })),
        ),
    })),
);
---

<Layout title="Chicio Labs">
    {
        sections.map((section) => (
            <section id={section.id} class="scroll-target mb-16">
                <SectionHeading title={section.title} description={section.subtitle} />
                <div class="grid gap-5 [grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr))]">
                    {section.cards.map(({ card, image }) => (
                        <HubCard card={card} image={image} tagLink={`#${section.id}`} />
                    ))}
                </div>
            </section>
        ))
    }
</Layout>
