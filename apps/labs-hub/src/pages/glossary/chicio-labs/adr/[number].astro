---
import { TerminalButton } from "matrix-design-system";
import DocumentBody from "../../../../components/DocumentBody.astro";
import Layout from "../../../../layouts/Layout.astro";
import { loadHubContent, systemUrl, type AdrDocument } from "../../../../lib/content";
import { decisionsAnchor } from "../../../../lib/navigation";

export async function getStaticPaths() {
    const { system } = await loadHubContent();

    return system.adrs.map((adr) => ({ params: { number: adr.number }, props: { adr } }));
}

interface Props {
    adr: AdrDocument;
}

const { adr } = Astro.props;
---

<Layout title={adr.title} description={`ADR ${adr.number} of Chicio Labs.`}>
    <DocumentBody html={adr.html} />
    <div class="mt-12">
        <TerminalButton label="Back to the Chicio Labs decisions" to={`${systemUrl}#${decisionsAnchor}`} />
    </div>
</Layout>
