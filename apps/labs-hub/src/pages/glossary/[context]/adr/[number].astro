---
import { TerminalButton } from "matrix-design-system";
import DocumentBody from "../../../../components/DocumentBody.astro";
import Layout from "../../../../layouts/Layout.astro";
import { loadHubContent, type AdrDocument, type GlossaryContext } from "../../../../lib/content";
import { decisionsAnchor } from "../../../../lib/navigation";

export async function getStaticPaths() {
    const { contexts } = await loadHubContent();

    return contexts.flatMap((context) =>
        context.adrs.map((adr) => ({ params: { context: context.id, number: adr.number }, props: { context, adr } })),
    );
}

interface Props {
    context: GlossaryContext;
    adr: AdrDocument;
}

const { context, adr } = Astro.props;
---

<Layout title={`${adr.title} (${context.name})`} description={`ADR ${adr.number} of ${context.name}.`}>
    <DocumentBody html={adr.html} />
    <div class="mt-12">
        <TerminalButton label={`Back to the ${context.name} decisions`} to={`${context.url}#${decisionsAnchor}`} />
    </div>
</Layout>
