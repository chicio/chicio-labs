{
  "name": "chicio-labs",
  "version": "5.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.0.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "turbo run dev --ui=tui",
    "dev:website": "turbo run dev --ui=tui --filter=website...",
    "dev:hub": "turbo run dev --ui=tui --filter=labs-hub...",
    "dev:design-system": "turbo run dev --ui=tui --filter=matrix-design-system-showcase...",
    "dev:rain": "turbo run dev --ui=tui --filter=matrix-rain-showcase...",
    "build": "turbo run build",
    "start": "npm run start --workspace=website",
    "lint": "turbo run lint",
    "knip": "turbo run knip",
    "typecheck": "turbo run typecheck",
    "validate-architecture": "turbo run validate-architecture",
    "verify-packages": "node scripts/verify-packages.mjs",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:ui": "npm run test:e2e:ui --workspace=website",
    "chat-knowledge-upload": "npm run chat-knowledge-upload --workspace=website",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "release-it",
    "prepare": "husky"
  },
  "devDependencies": {
    "@release-it/bumper": "^8.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "framer-motion": "^14.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "release-it": "^21.1.0",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom",
    "framer-motion": "$framer-motion",
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "allowScripts": {
    "agent-browser@0.33.2": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true,
    "unrs-resolver@1.11.1": true
  }
}
