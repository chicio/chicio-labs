{
  "name": "matrix-rain-webgpu",
  "version": "2.0.3",
  "description": "WebGPU/TypeGPU Matrix-rain background effect for React.",
  "keywords": [
    "background-effect",
    "matrix-rain",
    "react",
    "shader",
    "typegpu",
    "webgpu"
  ],
  "homepage": "https://labs.fabrizioduroni.it/matrix-rain/",
  "bugs": "https://github.com/chicio/chicio-labs/issues",
  "license": "MIT",
  "author": "Fabrizio Duroni",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chicio/chicio-labs.git",
    "directory": "packages/matrix-rain-webgpu"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "check": "oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt",
    "types": "tsc -b",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "lint": "oxlint --max-warnings 0 && oxfmt --check",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@typegpu/noise": "0.12.0",
    "@typegpu/react": "0.12.0",
    "typegpu": "0.12.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "^0.1.74",
    "eslint-plugin-typegpu": "^0.12.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "npm:tsover@6.0.2",
    "unplugin-typegpu": "^0.12.4",
    "vite": "^8.3.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
