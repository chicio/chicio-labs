{
  "name": "matrix-design-system",
  "version": "3.1.0",
  "description": "A Matrix-inspired React design system: green on near-black, terminal-flavoured, framework-agnostic.",
  "keywords": [
    "react",
    "design-system",
    "component-library",
    "tailwind",
    "matrix",
    "ui"
  ],
  "license": "MIT",
  "author": "Fabrizio Duroni",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chicio/chicio-labs.git",
    "directory": "packages/matrix-design-system"
  },
  "homepage": "https://github.com/chicio/chicio-labs/tree/main/packages/matrix-design-system#readme",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./chart": {
      "types": "./dist/chart.d.mts",
      "default": "./dist/chart.mjs"
    },
    "./markdown": {
      "types": "./dist/markdown.d.mts",
      "default": "./dist/markdown.mjs"
    },
    "./command-palette": {
      "types": "./dist/command-palette.d.mts",
      "default": "./dist/command-palette.mjs"
    },
    "./styles.css": "./src/styles/index.css",
    "./theme.css": "./src/styles/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npx turbo run build --filter=matrix-design-system",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate-architecture": "depcruise src --config .dependency-cruiser.cjs",
    "release": "release-it"
  },
  "peerDependencies": {
    "cmdk": ">=1",
    "framer-motion": "^13.4.4",
    "react": ">=19",
    "react-dom": ">=19",
    "react-markdown": ">=10",
    "recharts": ">=3",
    "rehype-highlight": ">=7",
    "rehype-katex": ">=7",
    "remark-emoji": ">=5",
    "remark-gfm": ">=4",
    "remark-math": ">=6",
    "remark-parse": ">=11",
    "unified": ">=11"
  },
  "peerDependenciesMeta": {
    "cmdk": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "rehype-highlight": {
      "optional": true
    },
    "rehype-katex": {
      "optional": true
    },
    "remark-emoji": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    },
    "remark-math": {
      "optional": true
    },
    "remark-parse": {
      "optional": true
    },
    "unified": {
      "optional": true
    }
  },
  "dependencies": {
    "matrix-component-store": "^1.0.0",
    "matrix-rain-webgpu": "^2.0.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@eslint/js": "^10",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "cmdk": "^1.1.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^9",
    "eslint-plugin-chicio": "^1.0.0",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "framer-motion": "^13.4.4",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "tsdown": "0.23.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "unified": "^11.0.5",
    "vitest": "^5.0.2"
  }
}
